<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="500.0" prefWidth="750.0"
            xmlns="http://javafx.com/javafx/26"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="cl.duoc.vivero.controller.MainController">

   <children>

      <!-- ENCABEZADO -->
      <HBox prefHeight="100.0" prefWidth="750.0">
         <children>

            <Label alignment="CENTER"
                   contentDisplay="CENTER"
                   prefHeight="116.0"
                   prefWidth="389.0"
                   text="Vivero Hojas del Sur"
                   textAlignment="CENTER">
               <font>
                  <Font name="System Bold" size="24.0"/>
               </font>
            </Label>

            <Label fx:id="alertaLabel"
                   prefHeight="105.0"
                   prefWidth="359.0"
                   text="Alerta"
                   textAlignment="CENTER"
                   textFill="RED"
                   visible="false"/>

         </children>
      </HBox>

      <!-- FORMULARIO DE PLANTAS -->
      <VBox layoutY="100.0"
            prefHeight="400.0"
            prefWidth="237.0">

         <children>

            <Label text="Tipo de Planta"/>

            <ChoiceBox fx:id="tipoChoice"
                       onAction="#onSeleccionarTipo"
                       prefWidth="150.0"/>

            <Label text="Nombre"/>

            <TextField fx:id="nombreText"/>

            <Label text="Altura"/>

            <TextField fx:id="alturaText"/>

            <Label text="Cantidad"/>

            <TextField fx:id="cantidadText"/>

            <!-- PLANTAS INTERIORES -->
            <Label text="Plantas de Interior"
                   underline="true">
               <font>
                  <Font size="14.0"/>
               </font>
            </Label>

            <Label text="Volumen de Maceta (L)"/>

            <TextField fx:id="volumenText"/>

            <!-- PLANTAS EXTERIORES -->
            <Label text="Plantas de Exterior"
                   underline="true">
               <font>
                  <Font size="14.0"/>
               </font>
            </Label>

            <Label text="Especie"/>

            <TextField fx:id="especieText"/>

            <CheckBox fx:id="resistenteCheck"
                      mnemonicParsing="false"
                      text="Resiste las heladas"/>

            <CheckBox fx:id="disponibleCheck"
                      mnemonicParsing="false"
                      text="Listo para despacho"/>

            <!-- BOTONES -->
            <HBox prefHeight="100.0"
                  prefWidth="200.0">

               <children>

                  <Button fx:id="guardarButton"
                          mnemonicParsing="false"
                          onAction="#onGuardar"
                          prefHeight="25.0"
                          prefWidth="112.0"
                          text="Guardar"/>

                  <Button fx:id="limpiarButton"
                          mnemonicParsing="false"
                          onAction="#onLimpiar"
                          prefHeight="25.0"
                          prefWidth="114.0"
                          text="Limpiar"/>

               </children>

               <VBox.margin>
                  <Insets top="20.0"/>
               </VBox.margin>

            </HBox>

         </children>

         <padding>
            <Insets bottom="10.0"
                    left="10.0"
                    right="10.0"
                    top="10.0"/>
         </padding>

      </VBox>

      <!-- TABLA DE PLANTAS -->
      <VBox layoutX="230.0"
            layoutY="100.0"
            prefHeight="400.0"
            prefWidth="520.0">

         <children>

            <TableView fx:id="plantaTableView"
                       prefHeight="200.0"
                       prefWidth="500.0">

               <columns>

                  <TableColumn fx:id="tipoColumn"
                               prefWidth="85.0"
                               text="Tipo"/>

                  <TableColumn fx:id="nombreColumn"
                               prefWidth="115.0"
                               text="Nombre"/>

                  <TableColumn fx:id="alturaColumn"
                               prefWidth="90.0"
                               text="Altura (cm)"/>

                  <TableColumn fx:id="cantidadColumn"
                               prefWidth="85.0"
                               text="Cantidad"/>

                  <TableColumn fx:id="precioColumn"
                               prefWidth="85.0"
                               text="Precio"/>

               </columns>

               <VBox.margin>
                  <Insets bottom="10.0"
                          left="10.0"
                          right="10.0"
                          top="10.0"/>
               </VBox.margin>

            </TableView>

            <!-- BOTON ELIMINAR -->
            <Button fx:id="eliminarId"
                    mnemonicParsing="false"
                    prefHeight="30.0"
                    prefWidth="230.0"
                    text="Eliminar">

               <VBox.margin>
                  <Insets left="10.0"
                          right="10.0"
                          top="20.0"/>
               </VBox.margin>

            </Button>

         </children>

      </VBox>

   </children>

</AnchorPane>
